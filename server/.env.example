# Copy to .env and set values locally. Never commit .env.

# PostgreSQL (e.g. Neon). Not required for Phase 1 health/tests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Integration tests (optional). For Neon POS dev, use the same host/database as
# DATABASE_URL with schema=pakpos_integration_test (public schema stays untouched).
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&schema=pakpos_integration_test"

# HTTP port for NestJS
PORT=3000

# Node environment
NODE_ENV=development

# Authentication (required at server startup from Phase 4.6).
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

# Login rate limiting (PostgreSQL-backed; shared across instances).
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Only set when behind a trusted reverse proxy (hop count, not raw X-Forwarded-For).
# TRUST_PROXY_HOPS=1

# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# JWT_ISSUER=pak-pos-api
# JWT_AUDIENCE=pak-pos-clients
